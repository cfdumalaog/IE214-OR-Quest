# ─── Video & Audio Recordings (too large for git) ────────────────────────────
*.mp4
*.mov
*.avi
*.mkv
*.m4a
*.wav
*.mp3
*.aac

# ─── VTT Transcripts (auto-generated, large text files) ─────────────────────
*.vtt

# ─── PyInstaller Build Artifacts ────────────────────────────────────────────
build/
dist/
*.spec

# ─── Python Cache ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/

# ─── App Runtime Data (user-specific, browser cache, logs) ───────────────────
app/data/

# ─── Downloaded Zips ─────────────────────────────────────────────────────────
*.zip

# ─── OS / Editor Junk ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
.vscode/

# Browser extension files
*.crx
